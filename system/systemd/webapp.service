[Unit]
Description=Forest Navigation Web App
# 起動チェーン: battery-logger の後に、5秒あけて起動（電源スパイク分散）
After=network.target gpsd.service battery-logger.service

[Service]
User=@APP_USER@
WorkingDirectory=@APP_DIR@/
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 @APP_DIR@/app.py
Restart=always

[Install]
WantedBy=multi-user.target
